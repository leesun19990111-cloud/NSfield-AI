# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL / DIRECT_URL: Supabase 'postgres' owner 역할(RLS 우회).
# DATABASE_URL=pooler(6543, ?pgbouncer=true), DIRECT_URL=세션(5432, pgbouncer 없음).
# 서버 신뢰 SQL 함수(wallet_apply_tx, apply_topup)와 requireUser/requireAdmin로 가드된
# Server Action이 이 연결을 사용한다. RLS는 anon/authenticated(클라이언트) 키의 방어선이며,
# 이 서버측 Prisma 연결에는 적용되지 않는다.
DATABASE_URL=
DIRECT_URL=

# ── 외부 AI 모델 (소유주가 실제 키/엔드포인트 확정) ──
# 미설정 시 해당 모델만 동작하지 않음 (나머지 기능은 정상).
OPENAI_API_KEY=
GOOGLE_API_KEY=
KLING_API_KEY=
BYTEDANCE_API_KEY=
NANOBANANA_API_KEY=

# ── 환율 ──
EXCHANGE_RATE_API_URL=https://api.exchangerate.host

# ── 운영 ──
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 입금 계좌 (사용자에게 표시됨, 비밀 아님) ──
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=
