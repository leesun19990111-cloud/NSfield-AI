# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
# DATABASE_URL / DIRECT_URL use the Supabase 'postgres' owner role, which BYPASSES RLS.
# Server-trusted SQL functions (wallet_apply_tx, apply_topup) and Server Actions guarded by
# requireUser/requireAdmin rely on this. RLS is the defense layer for the anon/authenticated
# (client) Supabase keys, not for these server-side Prisma connections.

# 외부 AI 모델
OPENAI_API_KEY=

# 환율
EXCHANGE_RATE_API_URL=https://api.exchangerate.host

# 운영
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 입금 계좌 (사용자에게 표시됨, 비밀 아님)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=
